map $http_upgrade $wccs_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name @SERVER_NAME@;
    return 308 https://@SERVER_NAME@$request_uri;
}

server {
    listen 443 ssl;
    server_name @SERVER_NAME@;
    ssl_certificate /etc/wccs/tls/server.crt;
    ssl_certificate_key /etc/wccs/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    access_log /var/log/nginx/wccs-access.log;
    error_log /var/log/nginx/wccs-error.log;

    location = /api/device/maintenance/result {
        client_max_body_size 128m;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $wccs_connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
