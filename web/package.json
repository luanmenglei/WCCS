{
  "name": "wccs-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && vite build",
    "test": "node --import tsx --test src/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@fontsource/geist": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.7",
    "typescript": "5.9.3",
    "prettier": "3.9.10",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "@types/node": "24.10.1",
    "tsx": "4.23.15"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "eslint": {
      "minimatch": "11.0.5"
    }
  }
}
